# =====================================================================
# TRAVEL KARO — environment settings
# Copy this file to ".env" for LOCAL development. NEVER commit ".env".
#
# Keep LOCAL and PRODUCTION settings separate:
#   • Local  -> this .env (SQLite + local image folder; no Supabase needed)
#   • Prod   -> set these as Environment Variables in Vercel (never in the repo)
# Do NOT point local development at the production database.
# =====================================================================

# Signs the admin login cookie. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use the SAME value across all production instances so logins stay valid.
SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------
# LOCAL (default, zero setup): a SQLite file is created automatically.
DATABASE_URL=sqlite:///./travelkaro.db
#
# PRODUCTION (Supabase Postgres). Use the CONNECTION POOLER string (port 6543)
# for serverless, and keep sslmode=require. Example shape:
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------------
# SUPABASE STORAGE (package images)
# Leave ALL THREE blank for local dev -> images save to the local uploads/ folder.
# Set ALL THREE in production -> images upload to Supabase Storage.
# ---------------------------------------------------------------------
SUPABASE_URL=
# SECRET — server-side only. Never expose to the browser, never commit.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=packages

# ---------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------
SITE_URL=http://localhost:8000
# Set to "true" only on the live HTTPS site (enables secure cookies).
PRODUCTION=false
