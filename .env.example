# =====================================================================
# TRAVEL KARO — settings. Copy this file to ".env" and edit the values.
# =====================================================================

# A long random secret that signs the admin login cookie.
# Generate one by running:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database.
#  • Localhost (easiest, nothing to install): leave as the SQLite line below.
#    A file "travelkaro.db" is created automatically on first run.
#  • Production PostgreSQL: use a line like
#    postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./travelkaro.db

# Your public website address (used for SEO / sitemap / Open Graph).
SITE_URL=http://localhost:8000

# Set to "true" only on your live server (enables secure cookies over HTTPS).
PRODUCTION=false
